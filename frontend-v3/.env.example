# Backend da aplicação (compose local usa /api via nginx na porta 80)
VITE_API_BASE_URL=/api
# Dados reais por padrão; use true apenas para desenvolvimento offline
VITE_USE_MOCK_DATA=false

# Painel Power BI (mesma fonte que o CSV em chamados_pbi)
# VITE_CHAMADOS_IFRAME_URL=https://app.powerbi.com/view?r=...

# OpenRouter — explicações operacionais nos cards de resumo (PredictionSummary)
# Nunca commite a chave real; copie este arquivo para .env e preencha localmente.
VITE_OPENROUTER_API_KEY=
VITE_OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Opcional: alguns provedores pedem referer / título da app
# VITE_OPENROUTER_HTTP_REFERER=https://localhost
# VITE_OPENROUTER_APP_TITLE=Flood Watch Hub
